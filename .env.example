# Clé API OpenAI.
OPENAI_API_KEY=ta_cle_openai_ici

# Dossiers utilisés par le RAG.
# Laisse commenté pour utiliser data/pdfs et data/index dans le projet.
# RAG_PDF_DIR=/chemin/vers/tes/pdf
# RAG_INDEX_DIR=/chemin/vers/ton/index

# Dossier où stocker les pages web contrôlées.
# RAG_WEB_DIR=/chemin/vers/tes/pages_web

# Domaines autorisés pour l'indexation web contrôlée.
# Laisse vide pour un RAG générique sans web.
# Exemple Everpure :
# RAG_ALLOWED_WEB_DOMAINS=purestorage.com,docs.purestorage.com,support.purestorage.com
RAG_ALLOWED_WEB_DOMAINS=

# Modèle qui rédige la réponse finale.
OPENAI_MODEL=gpt-4.1-nano

# Température du modèle de réponse.
# 0 = plus stable et plus déterministe.
OPENAI_TEMPERATURE=0

# Modèle OpenAI qui transforme les textes en vecteurs.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Profil de domaine.
# generic = moteur RAG neutre, sans synonymes ou prompts metier.
# everpure = active les synonymes et consignes Everpure/Pure Storage.
RAG_DOMAIN_PROFILE=generic

# Nombre de morceaux de texte récupérés dans l'index pour répondre.
TOP_K=8

# Seuil minimal du score final après reranking.
# Augmente-le pour être plus strict, baisse-le si tu obtiens trop peu de résultats.
MIN_SCORE=0.10

# Nombre de candidats FAISS récupérés avant le reranking.
CANDIDATE_K=80

# Budget approximatif de contexte envoyé au modèle de réponse.
CONTEXT_TOKEN_BUDGET=6000

# Paramètres du chunking intelligent par phrases.
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_SENTENCES=2
